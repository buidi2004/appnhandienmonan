# Flask Configuration
FLASK_ENV=development
PORT=5000

# Firebase Configuration
FIREBASE_CONFIG_JSON=
# Or use service account key file (serviceAccountKey.json)

# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Upload Configuration
UPLOAD_FOLDER=uploads
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes

# Image Cache Configuration
IMAGE_CACHE_TTL_SECONDS=21600  # 6 hours
IMAGE_CACHE_MAX_SIZE=200  # Maximum number of cached images

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Rate Limiting
RATELIMIT_STORAGE_URL=redis://localhost:6379/1
RATELIMIT_ENABLED=true

# Request/Response Logging
ENABLE_REQUEST_LOGGING=true
LOG_HEALTH_CHECKS=false  # Set to true to log health check requests

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
